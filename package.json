{
  "name": "dsh-chef",
  "version": "0.1.0",
  "private": true,
  "description": "主厨 Master Agent：左侧栏常驻入口 + 一个常驻的总调度 preset。不绑任何业务领域。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "license": "0BSD"
}
